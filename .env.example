# Amazon Sentinel — Environment Configuration Example
# Copy this file to .env and provide valid credentials where available.
# Never commit .env or expose secrets to the frontend.

# Application Settings
APP_NAME="Amazon Sentinel Data Engineering & Processing System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# API & Security Settings
API_PREFIX="/api"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
MAX_REQUEST_SIZE_BYTES=5242880

# Google Earth Engine (Sentinel-1 SAR & NASA GPM IMERG)
GEE_PROJECT_ID="your-gcp-earth-engine-project-id"
GEE_SERVICE_ACCOUNT_EMAIL=""
GEE_PRIVATE_KEY_PATH=""

# Global Forest Watch Data API (RADD & GLAD Alerts)
GFW_API_BASE_URL="https://data-api.globalforestwatch.org"
GFW_API_KEY="your-gfw-api-key"

# NASA Earthdata / Alaska Satellite Facility (ASF DAAC) for NISAR L-band
EARTHDATA_USERNAME="your-earthdata-username"
EARTHDATA_PASSWORD="your-earthdata-password"
EARTHDATA_BEARER_TOKEN=""
ASF_SEARCH_API_URL="https://api.daac.asf.alaska.edu/services/search/param"
ASF_S3_CREDENTIAL_ENDPOINT="https://nisar.asf.earthdatacloud.nasa.gov/s3credentials"
ASF_AWS_REGION="us-west-2"

# Storage & Caching
STORAGE_DIR="./data_storage"
CACHE_BACKEND="sqlite"
CACHE_DB_PATH="./data_storage/cache.db"
CACHE_DEFAULT_TTL_SECONDS=3600
REDIS_URL=""
DATABASE_URL=""
